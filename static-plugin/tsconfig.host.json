{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "lib",
    "rootDir": "src",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": false,
    "sourceMap": true,
    "isolatedModules": false,
    "experimentalDecorators": false,
    "useDefineForClassFields": true,
    "types": []
  },
  "include": ["src/index.ts"]
}

